<div class="comments-waline" data-comments-mount>
  <div id="waline"></div>
</div>

<%# Shown by comments.ts when comments.waline.serverURL is empty. %>
<div class="comments-setup" data-comments-setup="waline" hidden>
  <p class="comments-setup-title"><%= __('comments_setup_title') %></p>
  <p class="comments-setup-desc"><%= __('waline_setup_desc') %></p>
  <a
    class="comments-setup-action"
    href="https://waline.js.org/guide/get-started/"
    target="_blank"
    rel="noopener noreferrer"
  ><%= __('waline_setup_action') %></a>
</div>
