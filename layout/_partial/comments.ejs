<%
  // Comment section shell.
  // The provider templates below are intentionally static mount points — all
  // runtime logic lives in src/client/comments.ts so it survives PJAX swaps.
  var commentsCfg = theme.comments || {};
  var type = (commentsCfg.type || 'waline').toLowerCase();
  var providers = ['giscus', 'disqus', 'waline', 'twikoo', 'valine', 'gitalk', 'utterances'];
  var enabled = commentsCfg.enable && page.comments !== false && type !== 'none' && providers.indexOf(type) !== -1;
%>
<% if (enabled) { %>
<section
  class="comments"
  id="comments"
  data-comment-type="<%= type %>"
  data-page-url="<%= (config.url || '').replace(/\/$/, '') + '/' + page.path %>"
  data-page-identifier="<%= page.path %>"
  data-lang="<%= page.lang || config.language || 'en' %>"
>
  <div class="comments-header">
    <h3 class="comments-title"><%= __('comment') || 'Comments' %></h3>
  </div>

  <div class="comments-body">
    <div class="comments-loading" aria-hidden="true">
      <span class="comments-loading-bar"></span>
      <span class="comments-loading-bar"></span>
      <span class="comments-loading-bar comments-loading-bar-short"></span>
    </div>

    <%- partial('_partial/comments/' + type) %>

    <div class="comments-setup" data-comments-setup="generic" hidden>
      <p class="comments-setup-title"><%= __('comments_setup_title') %></p>
      <p class="comments-setup-desc"><%= __('comments_unconfigured_desc') %></p>
    </div>

    <div class="comments-setup comments-error" data-comments-error hidden>
      <p class="comments-setup-title"><%= __('comments_error_title') %></p>
      <p class="comments-setup-desc"><%= __('comments_error_desc') %></p>
      <button type="button" class="comments-setup-action" data-comments-retry>
        <%= __('comments_retry') %>
      </button>
    </div>
  </div>
</section>
<% } %>
