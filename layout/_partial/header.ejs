<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="site-logo" href="<%= url_for('/') %>">
      <% if (theme.logo && theme.logo.image) { %>
        <img src="<%= url_for(theme.logo.image) %>" alt="<%= config.title %>" class="logo-img">
      <% } else { %>
        <span class="logo-text"><%= theme.logo && theme.logo.text ? theme.logo.text : config.title %></span>
      <% } %>
    </a>

    <%
    // Nav icons — disable with header.nav_icons: false
    var navIcons = !theme.header || theme.header.nav_icons !== false;
    %>
    <nav class="site-nav" id="site-nav">
      <% for (var name in theme.menu) { %>
        <a class="nav-item" href="<%= url_for(theme.menu[name]) %>">
          <% if (navIcons) { %><span class="nav-icon"><%- menu_icon(name) %></span><% } %>
          <span class="nav-text"><%= __(name.toLowerCase()) || name %></span>
        </a>
      <% } %>
    </nav>

    <%
    // Feed button — appears when a feed is configured (see _config.yml → feed),
    // hide it with header.rss_icon: false.
    var feedHref = null;
    var feedCfg = config.feed || {};
    if (feedCfg.type || feedCfg.path || feedCfg.atom) {
      var fTypes = [].concat(feedCfg.type || ['atom']);
      var fPaths = [].concat(feedCfg.path || []);
      feedHref = fPaths[0] || (fTypes[0] === 'rss2' ? 'rss2.xml' : 'atom.xml');
      if (feedHref.charAt(0) !== '/') feedHref = '/' + feedHref;
    }
    var showRss = feedHref && (!theme.header || theme.header.rss_icon !== false);
    %>
    <div class="header-actions">
      <% if (showRss) { %>
      <a class="btn-icon header-rss" href="<%= url_for(feedHref) %>" aria-label="RSS" title="RSS">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>
      <% } %>

      <button class="btn-icon search-toggle" id="search-toggle" aria-label="<%= __('search') %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </button>

      <button class="btn-icon theme-toggle" id="theme-toggle" aria-label="<%= __('dark_mode') %>">
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="btn-icon sidebar-toggle" id="sidebar-toggle" aria-label="<%= __('sidebar_toggle') %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12h18M3 6h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
