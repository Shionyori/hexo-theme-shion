<footer class="site-footer">
  <div class="footer-inner">
    <% if (theme.footer.social !== false && theme.sidebar.enable && theme.sidebar.social) { %>
    <div class="footer-social">
      <% for (var name in theme.sidebar.social) { %>
        <a class="social-link" href="<%= theme.sidebar.social[name] %>" target="_blank" rel="noopener" aria-label="<%= name %>">
          <span class="social-name"><%= name %></span>
        </a>
      <% } %>
    </div>
    <% } %>

    <div class="footer-info">
      <span class="copyright">
        <span class="copyright-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M15.4 9.3a4 4 0 1 0 0 5.4"/></svg>
        </span>
        <span class="sr-only">Copyright</span>
        <% if (theme.footer.since && theme.footer.since < date(Date.now(), 'YYYY')) { %><%= theme.footer.since %> &ndash; <% } %><%= date(Date.now(), 'YYYY') %> <%= config.author || config.title %>
      </span>

      <% if (theme.footer.icp) { %>
        <span class="footer-sep" aria-hidden="true">|</span>
        <a class="icp" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener"><%= theme.footer.icp %></a>
      <% } %>
    </div>

    <% if (theme.footer.powered_by || theme.footer.theme_by) { %>
    <div class="footer-credits">
      <% if (theme.footer.powered_by) { %>
        <span class="powered-by"><%- __('powered_by', '<a href="https://hexo.io/" target="_blank">Hexo</a>') %></span>
      <% } %>

      <% if (theme.footer.powered_by && theme.footer.theme_by) { %>
        <span class="footer-sep" aria-hidden="true">|</span>
      <% } %>

      <% if (theme.footer.theme_by) { %>
        <span class="theme-by"><%- __('theme_by', '<a href="https://github.com/Shionyori/hexo-theme-shion" target="_blank" rel="noopener">Shion</a>') %></span>
      <% } %>
    </div>
    <% } %>

    <%- partial('_partial/uptime') %>

    <%- partial('_partial/busuanzi') %>
  </div>
</footer>

<% if (theme.custom_js) { %>
  <% if (theme.custom_js.startsWith('http') || theme.custom_js.startsWith('/')) { %>
  <script src="<%= theme.custom_js.startsWith('http') ? theme.custom_js : url_for(theme.custom_js) %>"></script>
  <% } else { %>
  <script><%- theme.custom_js %></script>
  <% } %>
<% } %>
