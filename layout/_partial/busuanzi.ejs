<% if (theme.busuanzi && theme.busuanzi.enable) { %>
<div class="busuanzi" data-busuanzi>
  <% if (theme.busuanzi.site_uv !== false) { %>
  <span class="busuanzi-item">
    <span class="busuanzi-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
    </span>
    <span class="busuanzi-label"><%= __('visitors') %></span>
    <span id="busuanzi_value_site_uv" data-busuanzi-value>-</span>
  </span>
  <% } %>
  <% if (theme.busuanzi.site_uv !== false && theme.busuanzi.site_pv !== false) { %>
  <span class="footer-sep" aria-hidden="true">|</span>
  <% } %>
  <% if (theme.busuanzi.site_pv !== false) { %>
  <span class="busuanzi-item">
    <span class="busuanzi-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
    </span>
    <span class="busuanzi-label"><%= __('page_views') %></span>
    <span id="busuanzi_value_site_pv" data-busuanzi-value>-</span>
  </span>
  <% } %>
</div>
<script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js" data-busuanzi-script></script>
<% } %>
